name: Validate

on:
  workflow_dispatch: ~
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    - cron: "0 4 * * 1"

permissions:
  contents: read

jobs:
  validate:
    uses: Dr-Blank/ha-integration-ci/.github/workflows/validate.yaml@8bb8dd71791ffd3f07acbb90fea6ecbd63a03683 # v1.3.0
{% if hacs_ignore %}
    with:
{% if "brands" in hacs_ignore.split() %}
      # The domain is not in home-assistant/brands, which only accepts
      # integrations shipped with core.
{% endif %}
      hacs-ignore: {{ hacs_ignore }}
{% endif %}

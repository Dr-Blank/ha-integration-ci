[project]
name = "{{ repo_name }}"
version = "0.1.0"
description = "{{ description }}"
authors = [
    { name = "Dr-Blank", email = "64108942+Dr-Blank@users.noreply.github.com" },
]
requires-python = ">={{ python_versions[0] }}"
readme = "README.md"
license = "{{ license }}"
classifiers = [
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
{% for version in python_versions %}
    "Programming Language :: Python :: {{ version }}",
{% endfor %}
    "Topic :: Home Automation",
    "Topic :: Software Development :: Libraries :: Python Modules",
    "Typing :: Typed",
]
dependencies = []

[project.urls]
Homepage = "https://github.com/Dr-Blank/{{ repo_name }}"
Repository = "https://github.com/Dr-Blank/{{ repo_name }}"
Issues = "https://github.com/Dr-Blank/{{ repo_name }}/issues"

[dependency-groups]
dev = [
    "pytest",
    "pytest-asyncio",
    "pytest-cov",
    "ruff",
    "mypy",
{% if pylint %}
    "pylint",
{% endif %}
    "prek>=0.5.3",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package }}"]

[tool.hatch.build.targets.sdist]
include = ["src/{{ package }}", "tests", "README.md", "LICENSE"]

[tool.ruff]
line-length = 88
target-version = "py{{ python_versions[0] | replace('.', '') }}"
src = ["src", "tests"]

[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "W",    # pycodestyle warnings
    "F",    # pyflakes
    "I",    # isort
    "B",    # flake8-bugbear
    "C4",   # flake8-comprehensions
    "UP",   # pyupgrade
    "ARG",  # flake8-unused-arguments
    "SIM",  # flake8-simplify
    "RUF",  # ruff specific
    "ASYNC",
]
ignore = [
    # Prose in docstrings and comments is not wrapped. The formatter still keeps
    # code within line-length; long sentences are left alone deliberately.
    "E501",
    # A timeout argument is the usual API for callers, as in Home Assistant.
    "ASYNC109",
]

[tool.ruff.lint.per-file-ignores]
"tests/*" = ["ARG001", "ARG002"]

[tool.mypy]
python_version = "{{ python_versions[0] }}"
strict = true
warn_unreachable = true
files = ["src/{{ package }}", "tests"]
{% if mypy_untyped_modules %}

[[tool.mypy.overrides]]
module = [{% for module in mypy_untyped_modules %}"{{ module }}"{{ ", " if not loop.last }}{% endfor %}]
ignore_missing_imports = true
{% endif %}

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
addopts = "-ra"

[tool.coverage.run]
source = ["src/{{ package }}"]
{% if pylint %}

[tool.pylint.messages_control]
disable = [
    "line-too-long",
    "too-few-public-methods",
    "too-many-instance-attributes",
    "duplicate-code",
]
{% endif %}
